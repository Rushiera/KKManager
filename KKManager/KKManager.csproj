<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KMR</AssemblyName>
    <RootNamespace>KKManager</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.18.11</Version>
  </PropertyGroup>

  <!-- 发布版专用编译开关（发布规范 → WorkSpace:KKManager/revealer/RELEASE.md §三）：
       仅当 -p:ReleasePack=true 时定义 RELEASEPACK，使无参启动即起面板；
       调试版不带此属性 → 无参仍打印用法，走 启动.bat 显式传参。 -->
  <PropertyGroup Condition="'$(ReleasePack)' == 'true'">
    <DefineConstants>$(DefineConstants);RELEASEPACK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\wwwroot\index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
